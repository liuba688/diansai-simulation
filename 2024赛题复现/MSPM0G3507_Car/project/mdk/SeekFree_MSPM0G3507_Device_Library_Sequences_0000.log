[20:54:19.729]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[20:54:19.729]    <block atomic="false" info="">
[20:54:19.729]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[20:54:19.729]        // -> [isSWJ <= 0x00000001]
[20:54:19.729]      __var hasDormant = __protocol & 0x00020000;
[20:54:19.729]        // -> [hasDormant <= 0x00000000]
[20:54:19.729]      __var protType   = __protocol & 0x0000FFFF;
[20:54:19.729]        // -> [protType <= 0x00000002]
[20:54:19.729]    </block>
[20:54:19.729]    <control if="protType == 1" while="" timeout="0" info="">

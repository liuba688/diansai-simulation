[20:44:13.557]        // -> [partNum <= 0x0000BB88]
[20:44:13.557]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:44:13.557]        // -> [manuf <= 0x00000017]
[20:44:13.557]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:44:13.557]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:44:13.557]      isProduction = (version > 0);

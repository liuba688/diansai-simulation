[20:44:13.550]        // -> [partNum <= 0x00000000]
[20:44:13.550]      __var manuf = 0;
[20:44:13.550]        // -> [manuf <= 0x00000000]
[20:44:13.550]      __var isMSPM0G1X0X_G3X0X = 0;
[20:44:13.550]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:44:13.550]      __var isProduction = 0;
[20:44:13.551]        // -> [isProduction <= 0x00000000]
[20:44:13.551]      __var continueId = 0;
[20:44:13.551]        // -> [continueId <= 0x00000000]
[20:44:13.551]      deviceID =   Read32(0x41C40004);
[20:44:13.557]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:44:13.557]        // -> [deviceID <= 0x2BB8802F]
[20:44:13.557]      version = deviceID >> 28;
[20:44:13.557]        // -> [version <= 0x00000002]

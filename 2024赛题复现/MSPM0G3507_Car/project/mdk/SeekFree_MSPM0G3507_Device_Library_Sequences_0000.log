[18:35:57.756]            // =>  TRUE
[18:35:57.756]          <block atomic="false" info="">
[18:35:57.756]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:35:57.756]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:35:57.756]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:35:57.761]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:35:57.761]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset

[20:54:19.729]        // =>  FALSE
[20:54:19.729]      // skip if-block "protType == 1"
[20:54:19.729]    </control>
[20:54:19.729]    <control if="protType == 2" while="" timeout="0" info="">
[20:54:19.729]      // if-block "protType == 2"
[20:54:19.729]        // =>  TRUE
[20:54:19.729]      <control if="isSWJ" while="" timeout="0" info="">
[20:54:19.729]        // if-block "isSWJ"
[20:54:19.729]          // =>  TRUE
[20:54:19.729]        <control if="hasDormant" while="" timeout="0" info="">
[20:54:19.729]          // if-block "hasDormant"
[20:54:19.729]            // =>  FALSE
[20:54:19.729]          // skip if-block "hasDormant"
[20:54:19.729]        </control>
[20:54:19.729]        <control if="!hasDormant" while="" timeout="0" info="">
[20:54:19.729]          // if-block "!hasDormant"
[20:54:19.729]            // =>  TRUE
[20:54:19.729]          <block atomic="false" info="">
[20:54:19.729]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:54:19.736]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:54:19.736]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:54:19.736]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:54:19.736]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:54:19.739]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:54:19.739]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[20:54:19.739]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[20:54:19.739]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[20:54:19.744]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:54:19.744]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:54:19.744]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[20:54:19.744]          </block>
[20:54:19.744]          // end if-block "!hasDormant"
[20:54:19.744]        </control>
[20:54:19.744]        // end if-block "isSWJ"
[20:54:19.744]      </control>
[20:54:19.744]      <control if="!isSWJ" while="" timeout="0" info="">
[20:54:19.744]        // if-block "!isSWJ"
[20:54:19.744]          // =>  FALSE
[20:54:19.744]        // skip if-block "!isSWJ"
[20:54:19.744]      </control>

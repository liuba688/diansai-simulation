[22:54:05.193]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[22:54:05.193]    <block atomic="false" info="">
[22:54:05.193]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[22:54:05.193]        // -> [isSWJ <= 0x00000001]
[22:54:05.193]      __var hasDormant = __protocol & 0x00020000;

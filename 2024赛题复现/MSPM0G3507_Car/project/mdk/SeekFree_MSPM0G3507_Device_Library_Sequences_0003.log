[22:54:05.197]          // if-block "hasDormant"
[22:54:05.197]            // =>  FALSE
[22:54:05.197]          // skip if-block "hasDormant"
[22:54:05.197]        </control>
[22:54:05.197]        <control if="!hasDormant" while="" timeout="0" info="">
[22:54:05.197]          // if-block "!hasDormant"
[22:54:05.198]            // =>  TRUE
[22:54:05.198]          <block atomic="false" info="">
[22:54:05.198]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[22:54:05.200]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[22:54:05.201]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[22:54:05.202]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[22:54:05.203]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[22:54:05.205]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[22:54:05.205]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[22:54:05.207]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[22:54:05.207]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[22:54:05.209]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[22:54:05.209]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[22:54:05.211]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[22:54:05.211]          </block>

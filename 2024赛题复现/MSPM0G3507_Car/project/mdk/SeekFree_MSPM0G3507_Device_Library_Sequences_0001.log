[20:34:50.525]            // =>  TRUE
[20:34:50.525]          <block atomic="false" info="">
[20:34:50.525]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:34:50.527]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:34:50.528]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:34:50.530]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:34:50.530]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset

[20:28:35.548]      // skip if-block "protType == 1"
[20:28:35.548]    </control>
[20:28:35.548]    <control if="protType == 2" while="" timeout="0" info="">
[20:28:35.548]      // if-block "protType == 2"
[20:28:35.551]        // =>  TRUE
[20:28:35.551]      <control if="isSWJ" while="" timeout="0" info="">
[20:28:35.551]        // if-block "isSWJ"
[20:28:35.551]          // =>  TRUE
[20:28:35.551]        <control if="hasDormant" while="" timeout="0" info="">
[20:28:35.551]          // if-block "hasDormant"
[20:28:35.551]            // =>  FALSE
[20:28:35.551]          // skip if-block "hasDormant"
[20:28:35.551]        </control>
[20:28:35.552]        <control if="!hasDormant" while="" timeout="0" info="">
[20:28:35.552]          // if-block "!hasDormant"
[20:28:35.552]            // =>  TRUE
[20:28:35.552]          <block atomic="false" info="">
[20:28:35.552]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:28:35.554]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:28:35.554]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:28:35.554]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:28:35.554]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:28:35.559]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:28:35.559]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[20:28:35.561]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[20:28:35.561]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[20:28:35.562]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:28:35.562]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:28:35.562]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[20:28:35.562]          </block>
[20:28:35.562]          // end if-block "!hasDormant"
[20:28:35.562]        </control>
[20:28:35.562]        // end if-block "isSWJ"
[20:28:35.562]      </control>
[20:28:35.562]      <control if="!isSWJ" while="" timeout="0" info="">
[20:28:35.562]        // if-block "!isSWJ"
[20:28:35.562]          // =>  FALSE
[20:28:35.562]        // skip if-block "!isSWJ"
[20:28:35.562]      </control>
[20:28:35.562]      <block atomic="false" info="">
[20:28:35.562]        ReadDP(0x0);
[20:28:35.567]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[20:28:35.567]      </block>
[20:28:35.567]      // end if-block "protType == 2"
[20:28:35.567]    </control>

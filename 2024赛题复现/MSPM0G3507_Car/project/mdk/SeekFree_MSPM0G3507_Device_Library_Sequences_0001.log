[20:28:35.576]  <sequence name="DebugPortStart" Pname="" disable="false" info="">
[20:28:35.576]    <block atomic="false" info="">
[20:28:35.576]      __var SW_DP_ABORT       = 0x0;
[20:28:35.576]        // -> [SW_DP_ABORT <= 0x00000000]
[20:28:35.576]      __var DP_CTRL_STAT      = 0x4;
[20:28:35.576]        // -> [DP_CTRL_STAT <= 0x00000004]
[20:28:35.576]      __var DP_SELECT         = 0x8;
[20:28:35.576]        // -> [DP_SELECT <= 0x00000008]
[20:28:35.577]      __var powered_down      = 0;
[20:28:35.577]        // -> [powered_down <= 0x00000000]
[20:28:35.577]      WriteDP(DP_SELECT, 0x00000000);
[20:28:35.578]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[20:28:35.578]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[20:28:35.580]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[20:28:35.580]        // -> [powered_down <= 0x00000001]
[20:28:35.581]    </block>
[20:28:35.581]    <control if="powered_down" while="" timeout="0" info="">
[20:28:35.581]      // if-block "powered_down"
[20:28:35.581]        // =>  TRUE
[20:28:35.581]      <block atomic="false" info="">
[20:28:35.581]        Message(0, "Debug/System power-up request sent");
[20:28:35.583]        WriteDP(DP_CTRL_STAT, 0x50000000);
[20:28:35.585]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[20:28:35.586]      </block>
[20:28:35.586]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">

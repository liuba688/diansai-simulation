[19:08:29.990]        // -> [canReadPins <= 0x00000001]
[19:08:29.991]    </block>
[19:08:29.991]    <control if="" while="1" timeout="200" info="">
[19:08:29.991]      // while "1"  (timeout="200")
[19:08:29.991]      // while-condition  =>  TRUE
[19:08:29.991]      // while "1"  (timeout="200")
[19:08:29.991]      // while-condition  =>  TRUE
[19:08:29.991]      // while "1"  (timeout="200")
[19:08:29.991]      // while-condition  =>  TRUE
[19:08:29.991]      // while "1"  (timeout="200")
[19:08:29.992]      // while-condition  =>  TRUE
[19:08:29.992]      // while "1"  (timeout="200")
[19:08:29.992]      // while-condition  =>  TRUE

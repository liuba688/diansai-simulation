[20:28:35.656]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[20:28:35.656]    <block atomic="false" info="">
[20:28:35.656]      __var deviceID = 0;
[20:28:35.656]        // -> [deviceID <= 0x00000000]
[20:28:35.656]      __var version = 0;
[20:28:35.656]        // -> [version <= 0x00000000]
[20:28:35.656]      __var partNum = 0;
[20:28:35.656]        // -> [partNum <= 0x00000000]
[20:28:35.656]      __var manuf = 0;
[20:28:35.656]        // -> [manuf <= 0x00000000]
[20:28:35.656]      __var isMSPM0G1X0X_G3X0X = 0;
[20:28:35.656]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:28:35.656]      __var isProduction = 0;
[20:28:35.656]        // -> [isProduction <= 0x00000000]
[20:28:35.656]      __var continueId = 0;
[20:28:35.661]        // -> [continueId <= 0x00000000]
[20:28:35.661]      deviceID =   Read32(0x41C40004);
[20:28:35.667]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:28:35.667]        // -> [deviceID <= 0x2BB8802F]
[20:28:35.667]      version = deviceID >> 28;
[20:28:35.667]        // -> [version <= 0x00000002]
[20:28:35.667]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:28:35.667]        // -> [partNum <= 0x0000BB88]
[20:28:35.667]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:28:35.667]        // -> [manuf <= 0x00000017]
[20:28:35.667]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:28:35.667]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:28:35.667]      isProduction = (version > 0);
[20:28:35.667]        // -> [isProduction <= 0x00000001]
[20:28:35.667]    </block>
[20:28:35.667]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">

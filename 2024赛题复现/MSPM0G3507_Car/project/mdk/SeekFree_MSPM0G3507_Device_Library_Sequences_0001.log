[19:08:29.973]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[19:08:29.973]      __ap = 1; 
[19:08:29.973]        // -> [__ap <= 0x00000001]
[19:08:29.975]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[19:08:29.976]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[19:08:29.976]      __ap = 4;
[19:08:29.976]        // -> [__ap <= 0x00000004]
[19:08:29.976]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[19:08:29.981]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[19:08:29.981]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[19:08:29.981]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);

[19:08:29.993]        // =>  TRUE
[19:08:29.993]      <control if="" while="(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0" timeout="1000000" info="">
[19:08:29.994]        // while "(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0"  (timeout="1000000")
[19:08:29.996]          // -> [DAP_SWJ_Pins(0x80, 0x80, 0) => 0x8F]   (Out: nRESET=1  =>  In: SWCLK/TCK=1, SWDIO/TMS=1, TDI=1, TDO=1, nTRST=0, nRESET=1)
[19:08:29.996]        // while-condition  =>  FALSE
[19:08:29.997]        // end while "(DAP_SWJ_Pins(nReset, nReset, 0) & nReset) == 0"
[19:08:29.997]      </control>
[19:08:29.997]      // end if-block "canReadPins"
[19:08:29.997]    </control>
[19:08:29.997]    <control if="!canReadPins" while="" timeout="0" info="">
[19:08:29.997]      // if-block "!canReadPins"
[19:08:29.997]        // =>  FALSE
[19:08:29.997]      // skip if-block "!canReadPins"
[19:08:29.997]    </control>
[19:08:29.997]    <control if="(ACCESS_POINT_VAL & 0x00E00000) == 0" while="" timeout="0" info="">
[19:08:29.997]      // if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"
[19:08:29.997]        // =>  TRUE
[19:08:29.997]      <block atomic="false" info="">
[19:08:29.997]        WriteAP(0x00, 0x190008);
[19:08:29.997]          // -> [WriteAP(0x00000000, 0x00190008)]   (__dp=0x00000000, __ap=0x00000004)
[19:08:29.997]        WriteAP(0xF0, 0x01);
[19:08:30.001]          // -> [WriteAP(0x000000F0, 0x00000001)]   (__dp=0x00000000, __ap=0x00000004)
[19:08:30.001]      </block>
[19:08:30.001]      // end if-block "(ACCESS_POINT_VAL & 0x00E00000) == 0"

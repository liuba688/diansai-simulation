[20:28:35.588]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[20:28:35.588]        // while-condition  =>  FALSE
[20:28:35.588]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[20:28:35.588]      </control>

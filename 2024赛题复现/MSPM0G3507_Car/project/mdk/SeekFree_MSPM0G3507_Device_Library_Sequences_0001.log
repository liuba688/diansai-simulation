[20:28:35.548]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[20:28:35.548]    <block atomic="false" info="">
[20:28:35.548]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[20:28:35.548]        // -> [isSWJ <= 0x00000001]
[20:28:35.548]      __var hasDormant = __protocol & 0x00020000;
[20:28:35.548]        // -> [hasDormant <= 0x00000000]
[20:28:35.548]      __var protType   = __protocol & 0x0000FFFF;
[20:28:35.548]        // -> [protType <= 0x00000002]
[20:28:35.548]    </block>
[20:28:35.548]    <control if="protType == 1" while="" timeout="0" info="">
[20:28:35.548]      // if-block "protType == 1"

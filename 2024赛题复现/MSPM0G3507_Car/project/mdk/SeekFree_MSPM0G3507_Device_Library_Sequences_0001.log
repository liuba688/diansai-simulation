[19:08:29.949]      __var DP_SELECT         = 0x8;
[19:08:29.949]        // -> [DP_SELECT <= 0x00000008]
[19:08:29.949]      __var powered_down      = 0;
[19:08:29.949]        // -> [powered_down <= 0x00000000]
[19:08:29.949]      WriteDP(DP_SELECT, 0x00000000);
[19:08:29.952]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:08:29.952]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:08:29.954]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:08:29.954]        // -> [powered_down <= 0x00000001]
[19:08:29.954]    </block>
[19:08:29.954]    <control if="powered_down" while="" timeout="0" info="">
[19:08:29.954]      // if-block "powered_down"
[19:08:29.954]        // =>  TRUE
[19:08:29.954]      <block atomic="false" info="">
[19:08:29.954]        Message(0, "Debug/System power-up request sent");
[19:08:29.957]        WriteDP(DP_CTRL_STAT, 0x50000000);
[19:08:29.959]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[19:08:29.959]      </block>
[19:08:29.959]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[19:08:29.959]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")
[19:08:29.962]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[19:08:29.962]        // while-condition  =>  FALSE
[19:08:29.962]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[19:08:29.965]      </control>

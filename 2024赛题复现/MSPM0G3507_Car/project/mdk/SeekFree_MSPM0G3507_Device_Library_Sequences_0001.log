[19:08:29.970]          WriteDP(SW_DP_ABORT, 0x0000001E);
[19:08:29.973]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[19:08:29.973]        </block>
[19:08:29.973]        // end if-block "(__protocol & 0xFFFF) == 2"
[19:08:29.973]      </control>

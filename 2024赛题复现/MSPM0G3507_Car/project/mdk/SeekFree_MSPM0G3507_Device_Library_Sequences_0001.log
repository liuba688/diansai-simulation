[20:28:35.588]      </control>
[20:28:35.588]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[20:28:35.588]        // if-block "(__protocol & 0xFFFF) == 2"
[20:28:35.588]          // =>  TRUE
[20:28:35.588]        <block atomic="false" info="">
[20:28:35.588]          Message(0, "executing SWD power up");
[20:28:35.591]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[20:28:35.594]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
[20:28:35.594]          WriteDP(SW_DP_ABORT, 0x0000001E);
[20:28:35.594]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[20:28:35.594]        </block>
[20:28:35.594]        // end if-block "(__protocol & 0xFFFF) == 2"
[20:28:35.594]      </control>
[20:28:35.594]      // end if-block "powered_down"
[20:28:35.594]    </control>
[20:28:35.596]    <block atomic="false" info="">
[20:28:35.596]      __var DEBUG_PORT_VAL    = 0;
[20:28:35.597]        // -> [DEBUG_PORT_VAL <= 0x00000000]
[20:28:35.597]      __var ACCESS_POINT_VAL  = 0;
[20:28:35.597]        // -> [ACCESS_POINT_VAL <= 0x00000000]
[20:28:35.597]      __ap = 1; 
[20:28:35.597]        // -> [__ap <= 0x00000001]
[20:28:35.597]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[20:28:35.600]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[20:28:35.600]      __ap = 4;
[20:28:35.600]        // -> [__ap <= 0x00000004]
[20:28:35.600]      ACCESS_POINT_VAL = ReadAP(0x00);//Reading current state of access point
[20:28:35.606]        // -> [ReadAP(0x00000000) => 0x00080027]   (__dp=0x00000000, __ap=0x00000004)
[20:28:35.607]        // -> [ACCESS_POINT_VAL <= 0x00080027]
[20:28:35.607]      Message(0, "Current state of access point is: %x",ACCESS_POINT_VAL);

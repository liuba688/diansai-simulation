[19:24:40.911]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:24:40.911]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);

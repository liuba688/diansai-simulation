[20:35:28.394]        // -> [partNum <= 0x00000000]
[20:35:28.394]      __var manuf = 0;
[20:35:28.394]        // -> [manuf <= 0x00000000]
[20:35:28.395]      __var isMSPM0G1X0X_G3X0X = 0;
[20:35:28.395]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:35:28.395]      __var isProduction = 0;
[20:35:28.395]        // -> [isProduction <= 0x00000000]
[20:35:28.395]      __var continueId = 0;
[20:35:28.395]        // -> [continueId <= 0x00000000]
[20:35:28.395]      deviceID =   Read32(0x41C40004);
[20:35:28.402]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:35:28.402]        // -> [deviceID <= 0x2BB8802F]
[20:35:28.402]      version = deviceID >> 28;

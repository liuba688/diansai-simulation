[19:24:40.914]      <block atomic="false" info="">
[19:24:40.914]        Message(0, "Debug/System power-up request sent");
[19:24:40.916]        WriteDP(DP_CTRL_STAT, 0x50000000);
[19:24:40.919]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[19:24:40.919]      </block>
[19:24:40.919]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
[19:24:40.919]        // while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"  (timeout="1000000")

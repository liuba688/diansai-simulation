[20:35:28.403]        // -> [partNum <= 0x0000BB88]
[20:35:28.403]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:35:28.403]        // -> [manuf <= 0x00000017]
[20:35:28.403]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:35:28.403]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:35:28.404]      isProduction = (version > 0);

[19:24:40.885]            // =>  TRUE
[19:24:40.885]          <block atomic="false" info="">
[19:24:40.885]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:24:40.887]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]

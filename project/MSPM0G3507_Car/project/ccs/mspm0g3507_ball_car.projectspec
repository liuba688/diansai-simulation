<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context deviceFamily="ARM" deviceId="MSPM0G3507"/>
        </when>
    </applicability>

    <project
        title="MSPM0G3507 Ball Car"
        name="mspm0g3507_ball_car"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="MSPM0G3507"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM0-SDK"
        compilerBuildOptions="
            -I${PROJECT_ROOT}/project/code
            -I${PROJECT_ROOT}/project/user/inc
            -I${PROJECT_ROOT}/libraries/sdk/ti_config
            -I${PROJECT_ROOT}/libraries/zf_common
            -I${PROJECT_ROOT}/libraries/zf_components
            -I${PROJECT_ROOT}/libraries/zf_device
            -I${PROJECT_ROOT}/libraries/zf_driver
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -D__MSPM0G3507__
            -D__USE_SYSCONFIG__
            -O2
            -g
            -mcpu=cortex-m0plus
            -march=thumbv6m
            -mfloat-abi=soft
            -mthumb
            -Wall
            -Wextra
            -Wno-unused-parameter
            -ffunction-sections
            -fdata-sections
        "
        linkerBuildOptions="
            -l&quot;ti/driverlib/lib/ticlang/m0p/mspm0g1x0x_g3x0x/driverlib.a&quot;
            -L${PROJECT_ROOT}
            -L${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -Wl,--rom_model
            -Wl,--warn_sections
            -Wl,--unused_section_elimination
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        sourceLookupPath="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="MSPM0G3507 line following, MaixCAM ball approach, electromagnet pickup and line reacquisition controller">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>

        <file path="../code/ball_car.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="project/code"></file>
        <file path="../code/ball_car.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="project/code"></file>
        <file path="../code/car_app.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="project/code"></file>
        <file path="../code/car_app.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="project/code"></file>
